# Copy this file to .env and adjust if needed.
# Launch from the Docker folder:
#   cd Docker
#   Copy-Item .env.example .env
#   docker compose up --build -d
#
# Layout (siblings of Docker/):
#   PFEBACKEND/
#   PFEFRONTEND/
#   ai-recommendation-service/
#   evaluate evidence/
#
# Application URLs (host browser):
#   Frontend : http://localhost:5173
#   Backend  : http://localhost:9090
#   Reco AI  : http://localhost:8002/health
#   Accept.  : http://localhost:8003/health
#   Ollama   : http://localhost:11434
#
# NEVER run: docker compose down -v  (destroys PostgreSQL + Ollama + evidence volumes)

# PostgreSQL
POSTGRES_DB=pfe_backend_db
POSTGRES_USER=pfe_user
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_PORT=5432

# Backend (Spring Boot) — matches local non-Docker port 9090
BACKEND_PORT=9090
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/pfe_backend_db
SPRING_DATASOURCE_USERNAME=pfe_user
SPRING_DATASOURCE_PASSWORD=change-me-postgres-password

# Auth / JWT (placeholders — replace for any shared deployment)
APP_AUTH_JWT_SECRET=change-this-super-secret-key-at-least-32-characters
APP_AUTH_BOOTSTRAP_ENABLED=false
APP_AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@pfe.local
APP_AUTH_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
APP_AUTH_BOOTSTRAP_ADMIN_FULL_NAME=Super Admin

# Keep false when db/local-snapshot.sql is imported (full validated dataset).
APP_QUESTIONNAIRE_SEED_ENABLED=false
APP_DEMO_CLEANUP_ENABLED=false
APP_DEMO_SEED_SYNTHETIC=false

# Internal AI service URLs (Docker network DNS — never expose these to the browser)
APP_AI_RECOMMENDATION_BASE_URL=http://ai-recommendation:8002
APP_AI_RECOMMENDATION_TIMEOUT_SECONDS=9000
ACCEPTANCE_CRITERIA_BASE_URL=http://evaluate-evidence:8003
ACCEPTANCE_CRITERIA_TIMEOUT_SECONDS=9000

# AI recommendation service
RECOMMENDATION_PORT=8002
RECOMMENDATION_OLLAMA_MODEL=qwen3.5:9b
USE_OLLAMA=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_TIMEOUT_SECONDS=9000

# Acceptance Criteria / evaluate evidence
ACCEPTANCE_CRITERIA_PORT=8003
ACCEPTANCE_OLLAMA_BASE_URL=http://ollama:11434/v1
ACCEPTANCE_OLLAMA_MODEL=qwen2.5vl:7b
ACCEPTANCE_OLLAMA_TIMEOUT_SECONDS=9000
OLLAMA_API_KEY=ollama

# Ollama
OLLAMA_PORT=11434
# Default: Docker named volume. To reuse a local Ollama install, set a host path, e.g.:
# OLLAMA_DATA_PATH=C:/Users/YOU/.ollama
OLLAMA_DATA_PATH=pfe_ollama_data

# Frontend (Nginx serves production build; /api proxied to backend:9090)
FRONTEND_PORT=5173
