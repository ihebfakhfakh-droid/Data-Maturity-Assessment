# Local Docker Desktop env for this machine.
# Do not commit real secrets to Git. .env should stay ignored.

POSTGRES_DB=pfe_backend_db
POSTGRES_USER=pfe_user
POSTGRES_PASSWORD=123456
# Host port 5433 avoids clash with local PostgreSQL on 5432 during development.
POSTGRES_PORT=5433

BACKEND_PORT=9090
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/pfe_backend_db
SPRING_DATASOURCE_USERNAME=pfe_user
SPRING_DATASOURCE_PASSWORD=123456

APP_AUTH_JWT_SECRET=change-this-super-secret-key-at-least-32-characters
APP_AUTH_BOOTSTRAP_ENABLED=false
APP_AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@pfe.local
APP_AUTH_BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
APP_AUTH_BOOTSTRAP_ADMIN_FULL_NAME=Super Admin

APP_QUESTIONNAIRE_SEED_ENABLED=false
APP_DEMO_CLEANUP_ENABLED=false
APP_DEMO_SEED_SYNTHETIC=false

APP_AI_RECOMMENDATION_BASE_URL=http://ai-recommendation:8002
APP_AI_RECOMMENDATION_TIMEOUT_SECONDS=9000
ACCEPTANCE_CRITERIA_BASE_URL=http://evaluate-evidence:8003
ACCEPTANCE_CRITERIA_TIMEOUT_SECONDS=9000

RECOMMENDATION_PORT=8002
RECOMMENDATION_OLLAMA_MODEL=qwen3.5:9b
USE_OLLAMA=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_TIMEOUT_SECONDS=9000

ACCEPTANCE_CRITERIA_PORT=8003
ACCEPTANCE_OLLAMA_BASE_URL=http://ollama:11434/v1
ACCEPTANCE_OLLAMA_MODEL=qwen2.5vl:7b
ACCEPTANCE_OLLAMA_TIMEOUT_SECONDS=9000
OLLAMA_API_KEY=ollama

OLLAMA_PORT=11435
# Reuse host Ollama models (avoids re-downloading ~12GB). Stop host Ollama first.
OLLAMA_DATA_PATH=C:/Users/DEVOTEAM/.ollama
FRONTEND_PORT=5173
